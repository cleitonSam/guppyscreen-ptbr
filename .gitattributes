# Fim de linha LF (o do Linux) para tudo que roda na impressora, no WSL ou no
# GitHub, mesmo quando o projeto é baixado no Windows. O Git do Windows troca
# para CRLF e aí os scripts quebram ("$'\r': command not found").
*.sh                              text eol=lf
*.py                              text eol=lf
*.cfg                             text eol=lf
*.conf                            text eol=lf
*.patch                           text eol=lf
*.yml                             text eol=lf
k1/k1_mods/S[0-9][0-9]*           text eol=lf
k1/k1_mods/cleanup/S[0-9][0-9]*   text eol=lf
